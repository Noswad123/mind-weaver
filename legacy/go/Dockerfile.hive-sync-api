# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS build

WORKDIR /src

RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
  go build -trimpath -ldflags="-s -w" -o /out/hive-sync-api ./cmd/hiveSyncAPI

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=build /out/hive-sync-api /app/hive-sync-api

ENV PORT=8080

EXPOSE 8080

ENTRYPOINT ["/app/hive-sync-api"]
