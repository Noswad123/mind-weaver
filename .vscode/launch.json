{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [

    {
      "name": "Run todos",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/mw",
      "args": ["todos"],
      "env": {},
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run with custom args",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/mw",
      "args": ["${input:goArgs}"],
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "goArgs",
      "type": "promptString",
      "description": "Enter command-line arguments",
      "default": "--engrave"
    }
  ]
}
